  <diagram name="8. FLowChart" id="p66McXNiPaAeMivPJ37d">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0b-nwMr95KRb5ZiZiWMM-0" />
        <mxCell id="0b-nwMr95KRb5ZiZiWMM-1" parent="0b-nwMr95KRb5ZiZiWMM-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: neutral\n  layout: elk\n---\nflowchart TD\n  Mulai([Mulai]) --&gt; InLogin[/Masukan Email dan Password/]\n  InLogin --&gt; CekAuth{Autentikasi Berhasil?}\n  CekAuth -- Tidak --&gt; ErrAuth[/Tampilkan Pesan Akun Tidak Valid/]\n  ErrAuth --&gt; InLogin\n  \n  CekAuth -- Ya --&gt; InScan[/Scan QR Code Statis Kantor via Kamera HP/]\n  InScan --&gt; InGPS[/Baca Koordinat GPS, Akurasi, dan Device ID HP/]\n  InGPS --&gt; DeteksiIP[Deteksi IP Publik Pengguna di Server]\n  \n  DeteksiIP --&gt; CekQR{Token QR Cocok dengan Lokasi Aktif?}\n  CekQR -- Tidak --&gt; TolakQR[/Tampilkan Penolakan: QR Code Tidak Valid/]\n  TolakQR --&gt; CatatLogGagal[Catat Percobaan Gagal ke Audit Log]\n  CatatLogGagal --&gt; Selesai([Selesai])\n  \n  CekQR -- Ya --&gt; CekDevice{Perangkat Cocok dengan Terdaftar?}\n  CekDevice -- Tidak --&gt; TolakDevice[/Tampilkan Penolakan: Perangkat Tidak Dikenali/]\n  TolakDevice --&gt; CatatLogGagal\n  \n  CekDevice -- Ya --&gt; CekIP{IP Publik Ada di Daftar IP Kantor?}\n  CekIP -- Tidak --&gt; TolakIP[/Tampilkan Penolakan: Wajib Jaringan Kantor/]\n  TolakIP --&gt; CatatLogGagal\n  \n  CekIP -- Ya --&gt; CekAkurasi{Akurasi GPS &lt;= 50 Meter?}\n  CekAkurasi -- Tidak --&gt; TolakAkurasi[/Tampilkan Peringatan: Sinyal GPS Lemah, Coba Ulang/]\n  TolakAkurasi --&gt; Selesai\n  \n  CekAkurasi -- Ya --&gt; HitungJarak[Hitung Jarak Koordinat dengan Rumus Haversine]\n  HitungJarak --&gt; CekRadius{Jarak &lt;= Radius Kantor misal 100m?}\n  CekRadius -- Tidak --&gt; TolakRadius[/Tampilkan Penolakan: Di Luar Radius Kantor/]\n  TolakRadius --&gt; CatatLogGagal\n  \n  CekRadius -- Ya --&gt; CekDuplikasi{Sudah Absen pada Shift &amp; Hari Ini?}\n  CekDuplikasi -- Ya --&gt; TolakDuplikasi[/Tampilkan Penolakan: Sudah Melakukan Absensi/]\n  TolakDuplikasi --&gt; CatatLogGagal\n  \n  CekDuplikasi -- Tidak --&gt; CekWaktu{Waktu Server &lt;= Jam Masuk + Toleransi?}\n  CekWaktu -- Ya --&gt; SetHadir[Set Status: Hadir Tepat Waktu]\n  CekWaktu -- Tidak --&gt; SetTerlambat[Set Status: Terlambat]\n  \n  SetHadir --&gt; SimpanDB[Simpan Data ke Tabel Attendances dan Audit Log]\n  SetTerlambat --&gt; SimpanDB\n  \n  SimpanDB --&gt; OutSukses[/Tampilkan Konfirmasi dan Tiket Absensi Berhasil/]\n  OutSukses --&gt; Selesai\n\n  classDef default fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000;\n  linkStyle default stroke:#000000,stroke-width:1.5px;\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="vZDyMwi-H9LN4_1lodkH-0">
